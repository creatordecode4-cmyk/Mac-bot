# ── MAC Bot config ─────────────────────────────────────────────
# Copy this file to .env.local and paste ONE free API key below.

# Which AI to use: gemini | groq | openrouter | custom
# Tip: a comma list falls back automatically when one is rate-limited, e.g. gemini,groq
# Leave empty to auto-pick the first provider that has a key.
AI_PROVIDER=gemini

# Google Gemini (free) → https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (free) → https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (free models) → https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: change the model for a provider
# GEMINI_MODEL=gemini-flash-latest
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=google/gemma-4-31b-it:free   (any model ending in :free from openrouter.ai/models)
# OPENROUTER_VISION=true   (set false if your OpenRouter model can't read images)

# Optional: any OpenAI-compatible server (Ollama, LM Studio…) with AI_PROVIDER=custom
# CUSTOM_BASE_URL=http://localhost:11434/v1
# CUSTOM_MODEL=llama3.2
# CUSTOM_API_KEY=
# CUSTOM_VISION=false
